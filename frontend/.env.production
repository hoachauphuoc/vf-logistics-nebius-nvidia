# Build-time configuration for the deployed console.
#
# NEXT_PUBLIC_* values are inlined into the client bundle when `next build`
# runs, NOT read at runtime. The Cloud Run source deploy runs the build inside
# Cloud Build, so `gcloud run deploy --set-env-vars NEXT_PUBLIC_DEMO_MODE=false`
# would set a runtime variable that the already-built bundle never consults --
# and the deployed console would silently keep serving demo fixtures while
# appearing to work. This file is what actually turns demo mode off.
#
# FLASK_API_BASE is deliberately absent: it is read server-side inside the proxy
# route handler at request time, so it belongs in the runtime environment where
# it can be changed without a rebuild.
NEXT_PUBLIC_DEMO_MODE=false
