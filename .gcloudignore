# Files not uploaded to Cloud Build by `gcloud run deploy --source .`
#
# Without this file gcloud generates one that pulls in the ROOT .gitignore via
# #!include, and nothing else. Nested ignore files are not read -- so
# frontend/.gitignore, which excludes 496 MB of node_modules across 35,000
# files, has no effect on the upload; the frontend/ entries below do that job.
# frontend/.gcloudignore is likewise never read by this deploy.

.gcloudignore
.git
.gitignore

# Honour the root ignore rules (venv, __pycache__, .env, coverage).
#!include:.gitignore

# The console's build artefacts and dependencies. Its SOURCE is uploaded: the
# root Dockerfile builds frontend/ into the same image as the API. The image runs
# `npm ci` itself, so a host's node_modules would only be dead weight.
frontend/node_modules/
frontend/.next/
frontend/out/

# Benchmark and coverage artefacts. benchmark_report_cases.json alone is 848 KB
# of per-case detail that the runtime never reads.
artifacts/
benchmark_report*.json
.coverage
.pytest_cache/

# Tool caches. Git skips them through a .gitignore each tool writes inside its own
# cache, which gcloud never reads; .mypy_cache alone is 124 MB in 50 files.
.mypy_cache/
.ruff_cache/

# Not used at runtime. Both Dockerfiles copy src/ and data/hs_reference.yaml;
# the root one also builds frontend/ and copies entrypoint.sh.
tests/
scripts/
sample_docs/
docs/
infra/
.github/
.snowflake/
venv/
*.md
!README.md

# Everything under the top-level data/ except what the runtime reads: the HS
# reference, and the committed evaluation reports GET /api/v1/evaluation serves.
#
# The leading slash is load-bearing. gcloud's ignore matcher does not anchor
# `data/*` to this directory the way git does -- it matched src/vf_logistics/data/
# as well and dropped sanctions_seed.json from the image, which does not fail the
# build. It makes sanctions.load() return None, which makes every screening come
# back SANCTIONS_SCREENING_UNAVAILABLE, so shipments that should be BLOCKED on a
# designation get routed to a human instead.
/data/*
!/data/hs_reference.yaml
!/data/benchmark_results/
!/data/eval_results/
