# VF Logistics Fraud Detection — Nebius Token Factory + NVIDIA Nemotron, on Google Cloud infra

# Nebius Token Factory API key. Get one at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your-nebius-api-key

# Tavily API key, for the live sanctions/news search the compliance agent runs.
# Leave unset to run without it — the agent degrades to model-only screening.
TAVILY_API_KEY=your-tavily-api-key

# Text model for fraud detection + compliance screening (fast, everyday calls).
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Vision model for document intake (Token Factory has no NVIDIA vision model yet).
VISION_MODEL=openbmb/MiniCPM-V-4_5

# Investigation agent model, pinned separately (deep reasoning on escalated
# cases only). Set to nvidia/Nemotron-3-Ultra-550b-a55b for stronger reasoning
# if more Token Factory credit is available.
INVESTIGATION_MODEL=nvidia/nemotron-3-super-120b-a12b

# Your GCP project ID — Firestore, Pub/Sub, Cloud Storage and Model Armor stay
# on Google Cloud; only the AI model layer moved to Nebius.
PROJECT_ID=your-project-id

# Port gunicorn binds to. Cloud Run sets this automatically.
PORT=8080

# --- Roadmap only: not read by the current code path ---
# FIRESTORE_DATABASE=(default)
# BQ_DATASET=fraud_detection
# PUBSUB_TOPIC=shipment-events
