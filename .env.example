# Environment Configuration for VF Logistics Fraud Detection
#
# This file documents the environment variables used by the service.
# Copy to .env for local development; in Cloud Run, set via --set-env-vars.

# --------------------------------------------------------------------------
# Core Configuration
# --------------------------------------------------------------------------

# Environment identifier: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Nebius Token Factory (AI)
# --------------------------------------------------------------------------

# Nebius API key for Token Factory access
NEBIUS_API_KEY=your-nebius-api-key-here

# Model selection
#
# These ids must match config.PRICING exactly, casing and all. They are read
# straight from the environment and do NOT pass through the PRICING check that
# POST /api/v1/config/model enforces, so a typo does not fail -- it costs every
# call at the cheapest rate in the table and under-reports spend. The service
# logs that at ERROR on startup and per call. `openbmb/minicpm-v-4.5` and
# `openbmb/MiniCPM-V-4_5` are not the same string.
#
# FRAUD_MODEL and COMPLIANCE_MODEL used to be listed here and are not read by
# anything: fraud and compliance both use NEMOTRON_MODEL.
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
INVESTIGATION_MODEL=nvidia/nemotron-3-super-120b-a12b
VISION_MODEL=openbmb/MiniCPM-V-4_5

# The debate agent, and the ONE place Nemotron Ultra is used by default.
#
# Ultra is 1.00/3.00 per million against Super's 0.30/0.90. It is deliberately not
# used on fraud detection or compliance, and the reason is architectural rather than
# financial: verifier.py computes a deterministic risk floor, and an agent may raise
# risk but never lower it below that floor -- so a stronger model cannot move the
# outcome in the direction that matters.
#
# The debate is the exception. It runs only on a disputed score (measured: 2 calls
# across 20 cases) and its CONFIRM/DISAGREE IS the outcome rather than a score the
# floor will override. At that volume the switch costs about $0.007 per 20 cases.
#
# This is a quality bet, not a measured improvement. Run
# scripts/compare_debate_models.py to settle it, and set this back to
# nvidia/nemotron-3-super-120b-a12b if the numbers disagree -- no deploy needed.
DEBATE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# How much dearer a model POST /api/v1/config/model may select without confirmation,
# measured against the CHEAPEST entry in config.PRICING.
#
# That endpoint drives fraud detection and compliance, which run on every shipment,
# and the change takes effect on the next one with nothing in the audit trail. On the
# blended input+output rate: Super is 4.0x Nano (permitted), Ultra is 13.3x (refused
# without `confirm_higher_cost: true`, answered 409 with the numbers).
#
# The baseline is fixed rather than relative to the current model because a relative
# comparison RATCHETS: Nano->Super is 4.0x and Super->Ultra is only 3.3x, so two
# ordinary requests used to walk past a 5.0 limit.
MODEL_SWITCH_MAX_RATE_MULTIPLE=5.0

# --------------------------------------------------------------------------
# Tavily search cost controls
# --------------------------------------------------------------------------
#
# TAVILY IS THE BINDING CONSTRAINT, not the model spend. Measured on a 20-case run:
# 90-106 searches at 4.5-5.3 per case, against $0.068 of Nemotron. At the free tier's
# 1,000 credits a month that is 188-222 cases -- while the model bill for the same
# traffic is under seven cents. GET /api/v1/billing/usage now reports
# tavily_searches / tavily_cached / tavily_billable beside estimated_cost_usd, which
# counts Nebius only.
#
# Caching is opt-in per call site and only successful searches are ever stored:
# caching a 429 or a missing-key failure would turn one outage into a TTL-long one,
# and would re-create the bug tavily_client was written to remove -- an outage read as
# a clean result. An empty OK result IS cached, because "we searched and found
# nothing" is a real answer. Set either to 0 to disable that cache.
#
# The cache is per-process memory, so on Cloud Run the hit rate depends on which
# instance serves the request. A cold instance after a deploy starts empty.

# The shipping-lane disruption search. Its query carries a country pair and nothing
# else -- no entity, no shipment, no value -- so two shipments on the same lane are
# asking a question with one answer. Measured: 20 searches resolved to 6 lanes.
TAVILY_ROUTE_CACHE_TTL_SECONDS=21600

# The shipper/receiver adverse-media searches. Shorter, because these carry a
# counterparty. Note that Tavily is NOT the sanctions control: that is
# validation.sanctions_screening, a separate deterministic path against the official
# list, and the risk floor comes from code-resident findings. A stale entry here
# delays an adverse-media signal -- a news article, not a designation.
# Measured: 20 shipper lookups resolved to 7 names, 20 receiver lookups to 6.
TAVILY_ENTITY_CACHE_TTL_SECONDS=3600

# How many DISTINCT transhipment hubs a route needs before the zero-day agent screens.
#
# Two, matching verifier.py's MULTIPLE_DIVERSION_HUBS: passing through one major port
# is freight, passing through several is a pattern. This gate guards the most
# expensive agent in the system -- 40% of all input tokens, 29.7s average -- and it
# used to admit 14 of 16 eligible cases, 13 of them on this indicator alone.
#
# Hubs are counted as PLACES, not string matches: DIVERSION_HUBS holds three nested
# names for one location ("jebel ali", "dubai", "uae"), so a single Emirati port used
# to count as two or three.
ZERO_DAY_MIN_DIVERSION_HUBS=2

# How far back the zero-day news search looks. Anything older is the official
# sanctions list's job, and duplicating it here spends tokens re-finding designations
# the deterministic check already has.
ZERO_DAY_NEWS_DAYS=45

# --------------------------------------------------------------------------
# Google Cloud Configuration
# --------------------------------------------------------------------------

# GCP project ID
PROJECT_ID=your-gcp-project-id

# Store backend: firestore | memory
STORE_BACKEND=firestore

# Cloud Storage bucket for document archival.
#
# Read at import time in document_store.py, so changing it needs a new revision.
#
# Losing this variable is silent and permanent for anything ingested while it is
# missing. The archive receipt is written onto the case at creation, so a case
# created without a bucket keeps `provenance.archived: false` for ever and its
# Review screen shows the gap message instead of the bill of lading -- setting the
# variable later does not repair past cases, only future ones.
#
# It HAS been lost once: a `gcloud run deploy --set-env-vars` replaced the whole
# environment instead of adding to it, and document archival stopped without any
# error. Always use --update-env-vars.
DOCUMENT_BUCKET=vf-fraud-detection-phuochoa-documents

# Google Model Armor integration - template must exist in MODEL_ARMOR_LOCATION.
# Region availability is limited; asia-southeast1 was not accepted, us-central1 was.
MODEL_ARMOR_TEMPLATE=vf-document-intake
MODEL_ARMOR_LOCATION=us-central1

# --------------------------------------------------------------------------
# Authentication (IAP)
# --------------------------------------------------------------------------

# Enable IAP authentication (set true in production)
IAP_ENABLED=false

# Shared secret for machine callers, presented as the X-VF-API-Key header.
#
# This is what the console's server-side proxy holds, and what makes a write
# reachable from the console but not by curling the service. Store it in Secret
# Manager and inject with `--set-secrets`, never as a literal --set-env-vars
# value: an env var literal is visible to anyone who can describe the service.
#
# Set the SAME value on the console service, where it is read as VF_API_KEY by
# frontend/src/app/api/proxy/[...path]/route.ts. Absent there, reads work and
# every write 403s.
VF_API_KEY=

# What a caller presenting no credential at all is allowed to do.
#
#   viewer            (default) reads answer, writes 403. The public demo posture.
#   none              anonymous callers are refused outright.
#   governance_admin  full access with no credential. LOCAL DEVELOPMENT ONLY --
#                     auth.assert_write_access_is_guarded() refuses to boot with
#                     this on STORE_BACKEND=firestore, because it is how an
#                     anonymous POST to /orchestrator/reset once cleared 307
#                     cases from the production store.
ANONYMOUS_ROLE=viewer

# --------------------------------------------------------------------------
# Console (the vf-console Cloud Run service, not this one)
# --------------------------------------------------------------------------
#
# Set these on the console service. They are listed here because the two
# services have to agree and the pairing is easy to miss.

# Backend base URL. Read server-side inside the proxy route at request time, so
# it can change without rebuilding the bundle.
FLASK_API_BASE=

# HMAC key for the console's session cookie. At least 32 characters; anything
# shorter is treated as absent. In production a missing value takes the console
# OFFLINE rather than opening it -- a dead console is a visible failure that gets
# fixed, an open one is not.
VF_SESSION_SECRET=

# Operator records, semicolon-separated: email:iterations:salt:hash (PBKDF2-SHA256).
# Generate with:
#   node frontend/scripts/make-operator.mjs you@example.com --out ./tmp
# which writes password.txt and record.txt and prints neither, so the password
# never enters terminal scrollback.
VF_OPERATORS=

# Whether anonymous visitors may READ the console. Writes are never covered by
# it: the split is scoped to the HTTP method, not to a path list, because a path
# list would have to be kept in step with the proxy's own allow-list and the two
# drifting apart is how a write route becomes readable by anyone.
#
# Defaults to false, and that is the point -- a deployment that forgets this is
# locked, not open. It is true on the hackathon deployment so a judge who never
# signs in still sees a working product instead of an empty page.
#
# Accepted consequence: an anonymous GET still carries VF_API_KEY upstream, so an
# anonymous reader sees review/queue and billing/usage, both of which sit above
# `viewer` on the backend. Turn this off before real customer data is in the store.
VF_PUBLIC_READS=false

# Request bounds. Each one caps something an attacker would otherwise repeat.
#
# MAX_DOCUMENT_MB also sets Flask's MAX_CONTENT_LENGTH (plus 2MB of multipart
# headroom), so an oversized body is refused from Content-Length rather than
# after being read into memory.
MAX_DOCUMENT_MB=20
# Elements per batch request on /fraud/batch and /investigation/report. Each
# element is one model call, so an unbounded array is one request that spends the
# whole balance.
MAX_BATCH_ITEMS=25
MAX_BULK_COUNT=10

# IAP audience (OAuth client ID)
IAP_AUDIENCE=your-iap-client-id.apps.googleusercontent.com

# Allowed email domains (comma-separated)
IAP_ALLOWED_DOMAINS=yourdomain.com

# Default role for new users (viewer | reviewer | operator | governance_admin)
DEFAULT_ROLE=viewer

# Role mappings (JSON format, email -> roles)
# ROLE_MAPPINGS={"admin@yourdomain.com": ["governance_admin"], "ops@yourdomain.com": ["operator"]}

# --------------------------------------------------------------------------
# Orchestrator Configuration
# --------------------------------------------------------------------------

# Worker mode: ondemand | poll
# ondemand = request-driven, works with scale-to-zero
# poll = background loop, requires min-instances=1
WORKER_MODE=ondemand

# Risk thresholds
FRAUD_CLEAR_BELOW=40
INVESTIGATE_AT=70

# Retry configuration
MAX_ATTEMPTS=3
POLL_SECONDS=1.5
MAX_CONCURRENT=3

# Chain execution limits (for ondemand mode)
MAX_CHAIN_STEPS=6
CHAIN_BUDGET_SECONDS=120

# Case claim lease (seconds before expired claims can be reclaimed)
CLAIM_LEASE_SECONDS=180

# --------------------------------------------------------------------------
# Drift Detection (Governance)
# --------------------------------------------------------------------------

# Minimum sample size before drift is evaluated
DRIFT_MIN_SAMPLE=8

# Maximum acceptable rates before suspending agent
DRIFT_MAX_AUTO_RELEASE_RATE=0.85
DRIFT_MAX_VETO_RATE=0.60
DRIFT_MAX_INJECTION_RATE=0.20

# --------------------------------------------------------------------------
# External Integrations
# --------------------------------------------------------------------------

# Webhook URL for escalation notifications
WEBHOOK_URL=https://hooks.example.com/your-webhook

# Tavily API key for web research (investigation agent)
TAVILY_API_KEY=your-tavily-api-key

# --------------------------------------------------------------------------
# Development Only
# --------------------------------------------------------------------------

# Skip real tool execution (for testing)
# TOOLS_DRY_RUN=true

# Bootstrap boundary author (creates initial boundary without IAP)
# BOUNDARY_BOOTSTRAP_AUTHOR=admin@yourdomain.com
