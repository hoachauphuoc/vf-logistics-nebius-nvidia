# Environment Configuration for VF Logistics Fraud Detection
#
# This file documents the environment variables used by the service.
# Copy to .env for local development; in Cloud Run, set via --set-env-vars.

# --------------------------------------------------------------------------
# Core Configuration
# --------------------------------------------------------------------------

# Environment identifier: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Nebius Token Factory (AI)
# --------------------------------------------------------------------------

# Nebius API key for Token Factory access
NEBIUS_API_KEY=your-nebius-api-key-here

# Model selection
FRAUD_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
COMPLIANCE_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
INVESTIGATION_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
VISION_MODEL=openbmb/minicpm-v-4.5

# --------------------------------------------------------------------------
# Google Cloud Configuration
# --------------------------------------------------------------------------

# GCP project ID
PROJECT_ID=your-gcp-project-id

# Store backend: firestore | memory
STORE_BACKEND=firestore

# Cloud Storage bucket for document archival
DOCUMENT_BUCKET=vf-fraud-detection-phuochoa-documents

# Google Model Armor integration - template must exist in MODEL_ARMOR_LOCATION.
# Region availability is limited; asia-southeast1 was not accepted, us-central1 was.
MODEL_ARMOR_TEMPLATE=vf-document-intake
MODEL_ARMOR_LOCATION=us-central1

# --------------------------------------------------------------------------
# Authentication (IAP)
# --------------------------------------------------------------------------

# Enable IAP authentication (set true in production)
IAP_ENABLED=false

# IAP audience (OAuth client ID)
IAP_AUDIENCE=your-iap-client-id.apps.googleusercontent.com

# Allowed email domains (comma-separated)
IAP_ALLOWED_DOMAINS=yourdomain.com

# Default role for new users (viewer | reviewer | operator | governance_admin)
DEFAULT_ROLE=viewer

# Role mappings (JSON format, email -> roles)
# ROLE_MAPPINGS={"admin@yourdomain.com": ["governance_admin"], "ops@yourdomain.com": ["operator"]}

# --------------------------------------------------------------------------
# Orchestrator Configuration
# --------------------------------------------------------------------------

# Worker mode: ondemand | poll
# ondemand = request-driven, works with scale-to-zero
# poll = background loop, requires min-instances=1
WORKER_MODE=ondemand

# Risk thresholds
FRAUD_CLEAR_BELOW=40
INVESTIGATE_AT=70

# Retry configuration
MAX_ATTEMPTS=3
POLL_SECONDS=1.5
MAX_CONCURRENT=3

# Chain execution limits (for ondemand mode)
MAX_CHAIN_STEPS=6
CHAIN_BUDGET_SECONDS=120

# Case claim lease (seconds before expired claims can be reclaimed)
CLAIM_LEASE_SECONDS=180

# --------------------------------------------------------------------------
# Drift Detection (Governance)
# --------------------------------------------------------------------------

# Minimum sample size before drift is evaluated
DRIFT_MIN_SAMPLE=8

# Maximum acceptable rates before suspending agent
DRIFT_MAX_AUTO_RELEASE_RATE=0.85
DRIFT_MAX_VETO_RATE=0.60
DRIFT_MAX_INJECTION_RATE=0.20

# --------------------------------------------------------------------------
# External Integrations
# --------------------------------------------------------------------------

# Webhook URL for escalation notifications
WEBHOOK_URL=https://hooks.example.com/your-webhook

# Tavily API key for web research (investigation agent)
TAVILY_API_KEY=your-tavily-api-key

# --------------------------------------------------------------------------
# Development Only
# --------------------------------------------------------------------------

# Skip real tool execution (for testing)
# TOOLS_DRY_RUN=true

# Bootstrap boundary author (creates initial boundary without IAP)
# BOUNDARY_BOOTSTRAP_AUTHOR=admin@yourdomain.com
