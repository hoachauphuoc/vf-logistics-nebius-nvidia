# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Screenshots and docs (not needed in runtime)
screenshots/
*.md
!README.md

# Development files
.env
.env.local
.pre-commit-config.yaml
pyproject.toml
Makefile

# Frontend build output and host dependencies. The image runs `npm ci` and
# `npm run build` itself; copying a Windows host's node_modules over that would
# replace Linux binaries with ones that cannot run in the container.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/coverage/

# Local benchmark output (gitignored too)
artifacts/
benchmark_report*.json

# Test files
tests/
scripts/
sample_docs/

# Submission materials
SUBMISSION.md
demo_video/

# Large files that shouldn't be in the image
*.pdf
*.png
*.jpg
*.jpeg
